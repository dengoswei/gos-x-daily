{
  "comment": "Example only. Copy to a models.local.json (gitignored) and adjust. Only environment-variable NAMES belong here; never an API key. screen/story/compose are required; review is optional advisory feedback (never approval); judge is read only by prototype/eval.mjs as a development-time measurement.",
  "roles": {
    "screen": {
      "kind": "openai",
      "baseUrl": "https://api.deepseek.com/v1",
      "model": "deepseek-chat",
      "apiKeyEnv": "DEEPSEEK_API_KEY",
      "maxTokens": 4096
    },
    "story": {
      "kind": "anthropic",
      "baseUrl": "https://api.anthropic.com",
      "model": "claude-sonnet-5-5",
      "apiKeyEnv": "ANTHROPIC_API_KEY",
      "maxTokens": 8192
    },
    "compose": {
      "kind": "exec",
      "command": [
        "claude",
        "-p",
        "--model",
        "opus",
        "--output-format",
        "json",
        "--disallowed-tools",
        "*"
      ],
      "parse": "claude-json"
    },
    "review": {
      "kind": "openai",
      "baseUrl": "https://api.deepseek.com/v1",
      "model": "deepseek-reasoner",
      "apiKeyEnv": "DEEPSEEK_API_KEY",
      "maxTokens": 8192
    },
    "judge": {
      "kind": "anthropic",
      "baseUrl": "https://api.anthropic.com",
      "model": "claude-opus-5-5",
      "apiKeyEnv": "ANTHROPIC_API_KEY",
      "maxTokens": 4096
    }
  }
}
