{
  "comment": "Example only. Copy to a models.local.json (gitignored) and adjust. Only environment-variable NAMES belong here; never an API key. screen/story/compose are required; review is optional advisory feedback (never approval); judge is read only by prototype/eval.mjs as a development-time measurement. The exec role's '--disallowed-tools *' is UNVERIFIED as a wildcard: verify that your CLI version runs the role with no tools at all before using it (see README). Use maxTokensParam 'max_completion_tokens' on an openai role for OpenAI reasoning models.",
  "budget": {
    "maxCalls": 80,
    "maxInputTokens": 3000000,
    "maxOutputTokens": 300000
  },
  "roles": {
    "screen": {
      "kind": "openai",
      "baseUrl": "https://api.deepseek.com/v1",
      "model": "deepseek-chat",
      "apiKeyEnv": "DEEPSEEK_API_KEY",
      "maxTokens": 4096,
      "maxTokensRetry": 8192,
      "concurrency": 6
    },
    "story": {
      "kind": "anthropic",
      "baseUrl": "https://api.anthropic.com",
      "model": "claude-sonnet-5-5",
      "apiKeyEnv": "ANTHROPIC_API_KEY",
      "maxTokens": 8192,
      "maxTokensRetry": 16000,
      "concurrency": 4,
      "retry": { "maxAttempts": 4, "baseDelayMs": 2000, "maxDelayMs": 30000, "maxRetryAfterMs": 120000 }
    },
    "compose": {
      "kind": "exec",
      "command": [
        "claude",
        "-p",
        "--model",
        "opus",
        "--output-format",
        "json",
        "--disallowed-tools",
        "*"
      ],
      "parse": "claude-json"
    },
    "review": {
      "kind": "openai",
      "baseUrl": "https://api.deepseek.com/v1",
      "model": "deepseek-reasoner",
      "apiKeyEnv": "DEEPSEEK_API_KEY",
      "maxTokens": 8192,
      "maxTokensRetry": 16000,
      "concurrency": 4
    },
    "judge": {
      "kind": "anthropic",
      "baseUrl": "https://api.anthropic.com",
      "model": "claude-opus-5-5",
      "apiKeyEnv": "ANTHROPIC_API_KEY",
      "maxTokens": 4096,
      "concurrency": 4
    }
  }
}
